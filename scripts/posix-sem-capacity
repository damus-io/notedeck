#!/usr/bin/env python3
"""
Report how much of the POSIX named-semaphore namespace is still free.

Why anyone cares: LMDB (and so nostrdb, and so notedeck) locks an environment
on Apple platforms with two *named* POSIX semaphores, and unlinks them only
when the closing process holds that environment's exclusive lock. A run that
is killed or aborts mid-flight therefore leaks a pair into a namespace that is
system-wide, capped by `kern.posix.sem.max` (10000 out of the box), and
reclaimed by nothing short of a reboot. Once it fills, every `mdb_env_open`
fails with errno 28 (ENOSPC) and notedeck dies with `DbOpenFailed` — which
reads like a full disk and is not one. The E2E suites are the first to break,
because they open the most environments at once.

Usage:
    ./scripts/posix-sem-capacity           # report, warn under 64 free
    ./scripts/posix-sem-capacity --min 32  # exit 1 under 32 free

Recovery when this comes back low: reboot to clear the leaked names, or buy
headroom for this boot with `sudo sysctl -w kern.posix.sem.max=<larger>`.
"""

import argparse
import multiprocessing
import platform
import subprocess
import sys


def sysctl_int(name):
    """Read an integer sysctl, or None where there isn't one."""
    try:
        out = subprocess.run(
            ["sysctl", "-n", name], capture_output=True, text=True, check=True
        )
        return int(out.stdout.strip())
    except (OSError, subprocess.CalledProcessError, ValueError):
        return None


def free_capacity(ceiling):
    """Count the named semaphores we can still create.

    Holding each one is the only way to ask: there is no API that enumerates
    the namespace. They are released when this process exits, so the probe
    leaves the count where it found it.
    """
    held = []
    try:
        while len(held) < ceiling:
            try:
                held.append(multiprocessing.Semaphore(1))
            except OSError:
                break
        return len(held)
    finally:
        held.clear()


def main():
    parser = argparse.ArgumentParser(
        description="Report free POSIX named-semaphore capacity",
    )
    parser.add_argument(
        "--min",
        type=int,
        default=64,
        metavar="N",
        help="exit 1 when fewer than N names are free (default: 64)",
    )
    args = parser.parse_args()

    cap = sysctl_int("kern.posix.sem.max")
    # No cap to read means no probe ceiling either; 20000 is twice the Darwin
    # default, which is enough to show a healthy namespace as healthy.
    free = free_capacity(cap * 2 if cap else 20000)

    if cap is not None:
        print(f"kern.posix.sem.max  {cap}")
        print(f"in use              {cap - free}")
    print(f"free                {free}   (nostrdb takes 2 per open database)")

    if platform.system() != "Darwin":
        print()
        print("note: this namespace only throttles LMDB on Apple platforms —")
        print("      elsewhere it locks environments with pthread mutexes in")
        print("      lock.mdb and never touches a named semaphore.")
        return 0

    if free >= args.min:
        return 0

    print()
    print(f"only {free} free: nostrdb will fail to open with errno 28 (ENOSPC).")
    print("Reboot to clear the leaked names, or raise the cap for this boot:")
    print(f"    sudo sysctl -w kern.posix.sem.max={(cap or 10000) * 2}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
