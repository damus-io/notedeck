#!/usr/bin/env bash
#
# Run snapshot tests with lavapipe (software Vulkan) for deterministic output.
#
# Usage:
#   scripts/snapshot-test                       # run all snapshot tests
#   scripts/snapshot-test --update              # update snapshot images
#   scripts/snapshot-test <test_name>           # run a specific snapshot test
#   scripts/snapshot-test -p=notedeck_headway   # run only one crate's suite
#   scripts/snapshot-test --debug ...           # render from the debug build
#   scripts/snapshot-test --changed --debug     # only suites the working tree can affect
#   scripts/snapshot-test --changed=master      # ... or everything since master
#
# Without --update it is the check: it runs every selected suite to the end and
# then names each png that no longer matches its render (the `.new.png` kittest
# left beside it), exiting 1 if any suite failed. A commit that changes a render
# re-records those pngs in the same commit, so the next card's `--update`
# rewrites only its own.
#
# --changed picks the suites through scripts/changed-crates: the crates the diff
# touches and every crate that depends on them. With no base it is the
# uncommitted work, which is what to run before committing.
#
# --debug renders from the debug build a session usually already has, instead
# of a cold release build of the crate's whole dependency tree (minutes, and
# OOM kills when two build at once). See the note above the `suites` loop for
# what it renders differently.
#
# On NixOS, LAVAPIPE_ICD is set by shell.nix. On standard Linux distros,
# lavapipe is found at /usr/share/vulkan/icd.d/lvp_icd.<arch>.json.
#
# On macOS there is no lavapipe, so every run delegates to a per-checkout
# docker container built from scripts/lavapipe.Dockerfile (which mirrors the
# CI snapshot job, so the pngs it generates match CI pixel-exactly).

set -euo pipefail

# Pin the timezone so timezone-dependent renders (e.g. Horizon's event inspector
# prints the local UTC offset via chrono `Local`) are identical on every machine
# and match CI's UTC runners. Without this, a snapshot generated on a dev box in
# a non-UTC zone differs from CI by exactly that offset label.
export TZ=UTC

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

update=""
# Empty filter runs every #[ignore]d test in the targeted binaries, minus each
# suite's `--skip`s (see `suites` below). Pass a name to narrow to specific
# tests.
filter=""
# Space-separated crates to run; empty runs every suite.
only=""
changed=""
release="--release"
# The args a docker re-exec gets: --changed resolved to -p=, since the
# container can't read a worktree's git dir. Expanded as ${args[@]+...}
# because macOS's bash 3.2 calls an empty array unbound under set -u.
args=()

for arg in "$@"; do
    case "$arg" in
        --update) update="1"; args+=("$arg") ;;
        --debug) release=""; args+=("$arg") ;;
        -p=*|--package=*) only="$only ${arg#*=}"; args+=("$arg") ;;
        --changed) changed="HEAD" ;;
        --changed=*) changed="${arg#*=}" ;;
        *) filter="$arg"; args+=("$arg") ;;
    esac
done

if [[ -n "$changed" ]]; then
    base=""
    [[ "$changed" != "HEAD" ]] && base="$changed"
    affected="$("$repo/scripts/changed-crates" $base | tr '\n' ' ')"
    if [[ -z "$affected" ]]; then
        echo "no crate changed (against $changed): no snapshot suite to run" >&2
        exit 0
    fi
    # intersect with any -p= the caller gave
    if [[ -n "$only" ]]; then
        keep=""
        for crate in $affected; do
            [[ " $only " == *" $crate "* ]] && keep="$keep $crate"
        done
        affected="$keep"
    fi
    only="$affected"
    if [[ -z "${only// /}" ]]; then
        echo "no selected crate changed (against $changed): no snapshot suite to run" >&2
        exit 0
    fi
    for crate in $only; do
        args+=("-p=$crate")
    done
fi

# macOS can't render snapshots natively: re-exec this script inside a lavapipe
# container bound to this checkout.
if [[ "$(uname -s)" == "Darwin" ]]; then
    if ! command -v docker >/dev/null; then
        echo "error: snapshots on macOS render with lavapipe in docker, but docker was not found." >&2
        exit 1
    fi
    # One container per checkout so parallel checkouts never share a mount.
    suffix="$(printf %s "$repo" | shasum | cut -c1-8)"
    name="notedeck-snap-$suffix"
    image="notedeck-lavapipe"

    if ! docker image inspect "$image" >/dev/null 2>&1; then
        echo "building $image image (one-time)..." >&2
        docker build -t "$image" -f "$repo/scripts/lavapipe.Dockerfile" "$repo/scripts"
    fi
    if ! docker container inspect "$name" >/dev/null 2>&1; then
        docker create --name "$name" \
            -v "$repo:/repo" \
            -v notedeck-snap-cargo:/cargo \
            -v "notedeck-snap-target-$suffix:/target" \
            "$image" >/dev/null
    fi
    # restart, not just start: the macOS bind mount can serve stale file
    # content to a long-running container, and a restart flushes it
    docker restart "$name" >/dev/null
    exec docker exec "$name" /repo/scripts/snapshot-test ${args[@]+"${args[@]}"}
fi

# Resolve lavapipe ICD path
if [[ -n "${LAVAPIPE_ICD:-}" ]]; then
    icd="$LAVAPIPE_ICD"
elif [[ -f "/usr/share/vulkan/icd.d/lvp_icd.$(uname -m).json" ]]; then
    icd="/usr/share/vulkan/icd.d/lvp_icd.$(uname -m).json"
else
    echo "error: lavapipe ICD not found." >&2
    echo "  NixOS: enter the nix shell (LAVAPIPE_ICD is set by shell.nix)" >&2
    echo "  Debian/Ubuntu: sudo apt install mesa-vulkan-drivers" >&2
    echo "  Fedora: sudo dnf install mesa-vulkan-drivers" >&2
    exit 1
fi

export VK_ICD_FILENAMES="$icd"
${update:+export UPDATE_SNAPSHOTS=1}
# Release builds default to non-incremental; force it on so iterating on a
# single crate only re-codegens what changed instead of the whole crate.
export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-1}"

# Each crate's snapshot suite:
#   "<crate>|<extra cargo args>|<extra harness args>|<release-only>"
# Running only the crate you're working on (scripts/snapshot-test
# -p=notedeck_headway) skips the four unrelated release builds, which dominate
# wall-clock time.
#
# The harness args field is for `--skip`ping #[ignore]d tests that are not
# lavapipe snapshot tests. `--ignored` with an empty filter sweeps in every
# ignored test in the listed binaries, and a test that skips itself at runtime
# is still reported as a pass — so anything ignored for a reason other than
# lavapipe has to be excluded here or CI claims to have run it.
#
# A non-empty release-only field keeps the suite in release under --debug: its
# tests hit an egui debug_assert (see the loop below) and abort.
suites=(
    "notedeck_chrome|--features auto-update,snapshot-testing --test ui_tests --test command_bar --test shot||release-only"
    "notedeck_ui|--test widget_tests --test chart_tests|"
    # test_real_codex_*: live-backend tests gated on CODEX_LIVE_TEST, which CI
    # never sets. Swept in they returned early and counted as passes.
    "notedeck_dave|--lib --test dave_button_tests --test ask_question_wrap_tests --test markdown_table_tests --test reference_chip_tests --test diff_view_tests --test chip_click_tests|--skip test_real_codex"
    "notedeck_nostrverse|--test snapshot_tests|"
    # Not a snapshot: renders a model view on lavapipe and compares pixels.
    "renderbud|--features egui,test-util --lib|"
    # --test-threads=1 --nocapture: this suite intermittently dies with SIGILL
    # on CI's x86_64 lavapipe (headway:notedeck/man-eight-damp), taking the
    # run's real result with it.
    #
    # One thread was first tried as a *fix* — the suite stands up 19 wgpu
    # devices, so concurrent lavapipe JIT was the leading suspect. It faulted
    # anyway, which refutes that and leaves the serialisation earning its ~4s a
    # different way: it attributes the crash. 18 tests now pass and the process
    # dies inside snapshot_switcher_same_slug_boards, which had never been
    # pinned down before.
    #
    # --nocapture because libtest buffers a test's stdout *and* stderr in memory
    # and prints them only on failure — so a SIGILL discards them, which is why
    # this went unattributed for so long. It is what lets that test's temporary
    # phase markers reach the log.
    #
    # Keep until the fault is understood; it has never reproduced locally,
    # including 100+ runs on aarch64 lavapipe both pinned to two cores and
    # unpinned across 18.
    "notedeck_headway|--features snapshot-testing --test snapshot_tests|--test-threads=1 --nocapture"
    "notedeck_notebook|--test snapshot_tests|"
    "notedeck_horizon|--test snapshot_tests|"
    "notedeck_cashflow|--test snapshot_tests --test hud_gallery --test categories --test trends --test overview --test journal|"
    # dashboard disabled for now: can't seem to regenerate its snapshots
    # "notedeck_dashboard|--features snapshot-testing --test snapshot_tests|"
)

# Snapshot tests are #[ignore]d by default so they don't run during
# normal `cargo test`. The --ignored flag runs only those tests.
#
# Release is the default because CI renders and compares in release. A debug
# build differs in two ways:
#
# - egui panics with "Widget ... changed layer_id during the frame" when a
#   widget moves between layers (tooltips: Background → Foreground). Chrome's
#   ui_tests and shot do, so chrome stays in release.
# - egui paints a red warning over any id clash. A test that clashes renders
#   differently in debug, and the fix is a ui.push_id in the test.
#
# Otherwise the pixels match. Measured on lavapipe (headway:notedeck/song-suggest-decorate):
# every png outside chrome rendered bit-identical in debug and release except
# those from tests that wait on the wall clock (a spinner, a clock, a popup still
# settling): a slower build draws them at a different frame, and some differ
# between two release runs too.
# CI is the check: a debug-recorded png it rejects is re-recorded without --debug.
failed=()
stale=()
for suite in "${suites[@]}"; do
    IFS='|' read -r crate cargo_args harness_args release_only <<< "$suite"
    if [[ -n "${only// /}" && " $only " != *" $crate "* ]]; then
        continue
    fi
    profile="$release"
    if [[ -z "$profile" && -n "$release_only" ]]; then
        echo "note: $crate renders in release even under --debug (egui debug_assert)" >&2
        profile="--release"
    fi
    dir="$repo/crates/$crate"
    # kittest clears a test's .new/.diff pngs only when that test runs again, so
    # clear the suite's up front: what is left afterwards is this run's.
    find "$dir" -path '*/snapshots/*' \( -name '*.new.png' -o -name '*.diff.png' \) -delete
    # --no-fail-fast: a failing binary would otherwise skip the suite's later
    # binaries, and their stale pngs with it.
    if ! cargo test --no-fail-fast $profile -p "$crate" $cargo_args -- --ignored $harness_args ${filter:+"$filter"}; then
        failed+=("$crate")
    fi
    # a png that differs from its render, or a snapshot never recorded
    while IFS= read -r new; do
        stale+=("${new#"$repo"/}")
    done < <(find "$dir" -path '*/snapshots/*' -name '*.new.png' | sort)
done

if [[ ${#failed[@]} -eq 0 ]]; then
    exit 0
fi

echo >&2
echo "snapshot suites failed: ${failed[*]}" >&2
if [[ ${#stale[@]} -gt 0 && -z "$update" ]]; then
    echo "these pngs no longer match their render (each .new.png is the render, .diff.png the difference):" >&2
    for new in ${stale[@]+"${stale[@]}"}; do
        echo "  ${new%.new.png}.png" >&2
    done
    echo "If your change restyled them on purpose, re-record them in this commit:" >&2
    echo "  scripts/snapshot-test --update -p=<crate> <test name>" >&2
    echo "If it didn't, the render has regressed." >&2
fi
exit 1
