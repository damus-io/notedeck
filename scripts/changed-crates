#!/usr/bin/env python3
"""
Print the workspace crates a diff can affect: every crate with a changed file,
and every workspace crate that depends on one of them, directly or not.

Usage:
    scripts/changed-crates           # working tree (staged, unstaged, untracked) vs HEAD
    scripts/changed-crates master    # everything since the merge base with master

A change to Cargo.toml, Cargo.lock or assets/ can reach any crate, so it prints
them all. Other files outside a crate (docs, scripts, CI) affect none.

One crate name per line, sorted. scripts/snapshot-test --changed uses it to run
only the snapshot suites a commit can have restyled.
"""

import json
import subprocess
import sys

EVERYTHING = ("Cargo.toml", "Cargo.lock", "assets/")


def git(*args):
    return subprocess.run(
        ["git", *args], capture_output=True, text=True, check=True
    ).stdout.splitlines()


def changed_files(base):
    if base is None:
        files = git("diff", "--name-only", "HEAD")
        files += git("ls-files", "--others", "--exclude-standard")
        return files
    return git("diff", "--name-only", f"{base}...HEAD") + git("diff", "--name-only", "HEAD")


def main():
    base = sys.argv[1] if len(sys.argv) > 1 else None
    root = git("rev-parse", "--show-toplevel")[0]
    meta = json.loads(
        subprocess.run(
            ["cargo", "metadata", "--no-deps", "--format-version", "1"],
            capture_output=True, text=True, check=True, cwd=root,
        ).stdout
    )
    members = meta["packages"]

    # crate dir relative to the repo, with a trailing slash so
    # crates/notedeck/ doesn't claim crates/notedeck_ui/'s files
    dirs = {}
    for pkg in members:
        manifest = pkg["manifest_path"]
        rel = manifest[len(root) + 1 : -len("Cargo.toml")]
        dirs[pkg["name"]] = rel

    files = changed_files(base)
    if any(f == e or f.startswith(e) for f in files for e in EVERYTHING):
        print("\n".join(sorted(dirs)))
        return

    affected = {
        name for name, d in dirs.items() if d and any(f.startswith(d) for f in files)
    }

    # dependents of each workspace crate, then close over them
    names = set(dirs)
    dependents = {name: set() for name in names}
    for pkg in members:
        for dep in pkg["dependencies"]:
            if dep["name"] in names:
                dependents[dep["name"]].add(pkg["name"])

    todo = list(affected)
    while todo:
        for user in dependents[todo.pop()]:
            if user not in affected:
                affected.add(user)
                todo.append(user)

    if affected:
        print("\n".join(sorted(affected)))


if __name__ == "__main__":
    main()
